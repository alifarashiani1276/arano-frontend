# فایل راهنما برای تنظیم متغیرهای محیطی (کپی کن به .env.development.local)

# آدرس API لاراول (پنل ادمین و وبلاگ). هنگام npm run build خوانده می‌شود:
# origin آن در connect-src سیاست CSP هم می‌نشیند؛ پس باید پیش از build درست تنظیم شده باشد.
VITE_BASE_URL=https://arano-backend.liara.run/api

# true => نمونه‌کارها از Mock Data خوانده می‌شود | false => از API لاراول (GET /projects)
VITE_USE_MOCK=true

# وبلاگ همیشه از API لاراول خوانده می‌شود: GET {VITE_BASE_URL}/blog/posts و /blog/posts/{slug}
